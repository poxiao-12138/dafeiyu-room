{
  "name": "dafeiyu-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --mode public",
    "preview": "vite preview --host 127.0.0.1",
    "check:public": "node scripts/check-public.mjs",
    "test:editor": "node tests/room-editor.test.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "start": "node server/start.js",
    "test:server": "node --test tests/server.test.mjs",
    "test:sync": "node --test tests/layout-sync.test.mjs",
    "dev:server": "node server/start.js --dev",
    "test:scenes": "node tests/scene-editor.test.mjs",
    "mcp:stdio": "node scripts/world-mcp-stdio.mjs",
    "test": "node --test tests/*.test.mjs desktop/test/*.test.mjs",
    "self-check": "node scripts/self-check.mjs",
    "check": "npm test && npm run build && npm run check:public",
    "world:publish-default": "node scripts/publish-starter-world.mjs",
    "desktop:probe": "node desktop/launch.mjs desktop/probe.cjs",
    "desktop:dev": "node desktop/launch.mjs desktop",
    "desktop:pack": "npm run build && electron-builder --dir --config desktop/electron-builder.yml",
    "desktop:dist:mac": "npm run build && electron-builder --mac --config desktop/electron-builder.yml",
    "desktop:dist:win": "npm run build && electron-builder --win --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "^5.12.8",
    "three": "0.170.0",
    "ws": "^8.22.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.24.0",
    "playwright": "1.49.0",
    "vite": "5.4.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "desktop/main.cjs",
  "description": "大肥鱼的小世界：2.5D 房间/院子/小镇，Three.js + Fastify + MCP",
  "author": "破晓手记"
}
